# ---------------------------------------------------------------------------
# Alpha Trade Oracle Bot — Beispielkonfiguration
# Kopieren mit:  cp .env.example .env
# Diese Datei enthaelt KEINE echten Secrets und darf eingecheckt werden.
# Die Datei .env selbst ist per .gitignore ausgeschlossen.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Schuetzt administrative API-Endpunkte (Header: X-Admin-Token)
ADMIN_API_TOKEN=change-me-admin-token

# --- Datenbank -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alpha_trade_oracle
POSTGRES_USER=alpha_trade_oracle
POSTGRES_PASSWORD=change-me

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Telegram --------------------------------------------------------------
# Token via @BotFather erzeugen. Chat-IDs als Komma-Liste.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_IDS=
# Signal-Alerts (Chart + Analyse). false = nur Paper-Trade open/close.
TELEGRAM_SIGNAL_DISPATCH=false

# --- Marktdaten ------------------------------------------------------------
# Fuer reine Marktanalysen wird KEIN API-Key benoetigt (public REST).
# Verfuegbar: binance | kucoin
MARKET_DATA_PROVIDER=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
KUCOIN_BASE_URL=https://api.kucoin.com

COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINMARKETCAP_API_KEY=

# --- LLM (OpenAI-kompatibel, z. B. OpenRouter) -----------------------------
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

NEWS_API_KEY=

# --- Analyse-Defaults ------------------------------------------------------
DEFAULT_QUOTE_ASSET=USDT
DEFAULT_TIMEFRAMES=15m,1h,4h,1d
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT
MAX_RISK_PERCENT=1.0
MIN_RISK_REWARD_RATIO=2.0

# --- Feature-Schalter ------------------------------------------------------
ENABLE_SENTIMENT=false
ENABLE_LLM_ANALYSIS=true
ENABLE_BACKTESTING=true
ENABLE_AUTO_CALIBRATION=false

# Top-N Market-Cap-Universe (CoinGecko) und Batch-Scans
ENABLE_UNIVERSE_SCAN=true

# --- Signal- und Risikoparameter ------------------------------------------
SIGNAL_MIN_SCORE=75
SIGNAL_REQUIRE_STRONG=true
SIGNAL_SHORT_MAX_SCORE=25
SIGNAL_COOLDOWN_MINUTES=120
SIGNAL_RSI_LONG_MAX=75
SIGNAL_RSI_SHORT_MIN=33
# Shorts mit Score <= Wert gelten als Erschoepfung (NO_TRADE / Dedup).
SIGNAL_SHORT_MIN_SCORE=18
SIGNAL_BLOCK_RANGE_MARKET=true
SIGNAL_MIN_ADX=20
# Signal-/Paper-Ablauf: N × Primary-TF (1h → 24h Hold/Expiry)
SIGNAL_EXPIRY_MULTIPLIER=24
PRIMARY_TIMEFRAME=1h
ATR_MULTIPLIER=1.5
MIN_STOP_DISTANCE_PERCENT=0.3
MAX_STOP_DISTANCE_PERCENT=8.0
# true = Setups mit zu weitem Stop verwerfen. false = handeln, aber das
# risikonormierte Sizing verkleinert die Position entsprechend.
REJECT_WIDE_STOPS=false
MAX_ATR_PERCENT=12.0
REFERENCE_CAPITAL=10000
# Take-Profit-Leiter (R-Multiples) und Paper-Scale-out
TP_MULTIPLIERS=2.0,4.0,6.0
PAPER_SCALE_OUT_FRACTIONS=0.5,0.25,0.25
# Symbol-Circuit-Breaker: 2 Verluste in Folge -> 24h Pause
PAPER_SYMBOL_CIRCUIT_BREAKER_LOSSES=2
PAPER_SYMBOL_CIRCUIT_BREAKER_HOURS=24
# UTC-Blackout fuer Entries (leer = aus)
SIGNAL_ENTRY_BLACKOUT_UTC=21:00-01:00
PAPER_ENTRY_BLACKOUT_UTC=21:00-01:00
# Nach TP1: Rest-Runner bis 48h ab Fill (0 = bei 24h belassen)
PAPER_EXPIRY_MULTIPLIER_AFTER_TP1=48
# BTC-Regime: Shorts in Bull / Longs in Bear blockieren (fehlende BTC-Daten = kein Filter).
REGIME_FILTER_ENABLED=true
REGIME_BTC_SYMBOL=BTCUSDT
REGIME_TIMEFRAME=4h

# --- Scheduler -------------------------------------------------------------
ENABLE_SCHEDULER=true
SCAN_INTERVAL_MINUTES=30
CANDLE_LIMIT=500
# CoinGecko-Abruf beim Mapping (Puffer: nicht alle Top-300 haben USDT-Pair)
UNIVERSE_SIZE=1000
UNIVERSE_SCAN_BATCH_SIZE=300
UNIVERSE_REFRESH_HOURS=24
UNIVERSE_EXCHANGES=kucoin,binance,coinbase
UNIVERSE_TICKER_FALLBACK=true
UNIVERSE_TICKER_FALLBACK_MAX=150
UNIVERSE_TARGET_COUNT=300
UNIVERSE_MAX_RANK=0
# Nur Paare aufnehmen, fuer die der Provider wirklich Kerzen liefert.
UNIVERSE_VERIFY_CANDLES=true
# Mindest-24h-Quotevolumen auf der gemappten Boerse. 0 = aus (Default): auf
# KuCoin-Spot wuerde schon 1 Mio USD 90% des Universe entfernen.
UNIVERSE_MIN_QUOTE_VOLUME_USD=0
# Muss mindestens so gross sein wie die tiefste nachgeladene Historie, sonst
# loescht der Prune-Job den Backfill wieder (siehe scripts/backfill_candles.py).
CANDLE_RETENTION_DAYS=730
COINBASE_BASE_URL=https://api.coinbase.com/api/v3/brokerage
COINBASE_QUOTE_ASSETS=USD,USDC,USDT

# --- Paper-Trading ---------------------------------------------------------
ENABLE_PAPER_TRADING=true
PAPER_INITIAL_BALANCE=5000
# Fixe Margin wird nur noch genutzt, wenn PAPER_RISK_PER_TRADE_USD=0 ist.
PAPER_MARGIN_PER_TRADE=100
PAPER_LEVERAGE=10
# Risikonormiertes Sizing: Stueckzahl = Risiko / Stop-Abstand (1% von 5.000).
PAPER_RISK_PER_TRADE_USD=50
PAPER_MAX_NOTIONAL_USD=1500
# Portfolio-Limits: Summe des offenen Restrisikos, Anzahl und Richtungs-Klumpen.
PAPER_MAX_PORTFOLIO_RISK_PCT=10
PAPER_MAX_OPEN_POSITIONS=10
PAPER_MAX_OPEN_PER_DIRECTION=6
# Perpetual-Taker je Seite (Spot waere 0.1 und wuerde die Kosten verdoppeln).
PAPER_FEE_PERCENT=0.05
PAPER_MOVE_STOP_TO_BREAKEVEN=true
PAPER_UPDATE_INTERVAL_MINUTES=5
# Retest/Pullback-Entry (Default ON): besserer Entry; Hold/Expiry = 24h ab Signal.
# Long/Short erst nach Touch der ATR-Zone (0.55–1.0×ATR vom Signal-Entry).
PAPER_RETEST_ENTRY_ENABLED=true
PAPER_RETEST_ZONE_NEAR=0.55
PAPER_RETEST_ZONE_FAR=1.0
PAPER_RETEST_PENDING_MULTIPLIER=6
PAPER_RETEST_MIN_BARS_IN_ZONE=2
# Early-Scratch: Position schliessen wenn MFE < 0.5R nach 8h (0 = aus).
PAPER_EARLY_SCRATCH_HOURS=8
PAPER_EARLY_SCRATCH_MFE_R=0.5
# Backtest: Retest statt Immediate/IST (naechster 1h-Open).
BACKTEST_RETEST_ENTRY_ENABLED=true

# --- HTTP ------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0
HTTP_MAX_RETRIES=3
MARKET_DATA_CACHE_TTL_SECONDS=60

# --- Ausgabe ---------------------------------------------------------------
DISPLAY_TIMEZONE=Europe/Berlin
