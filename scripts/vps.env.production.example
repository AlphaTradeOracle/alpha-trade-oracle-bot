# VPS-Produktion — nach /opt/alpha-trade-oracle-bot/.env kopieren und Secrets eintragen.
APP_ENV=production
LOG_LEVEL=INFO
ADMIN_API_TOKEN=change-me-to-a-long-random-token

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alpha_trade_oracle
POSTGRES_USER=alpha_trade_oracle
POSTGRES_PASSWORD=change-me-strong-db-password

REDIS_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_IDS=

MARKET_DATA_PROVIDER=binance
DEFAULT_QUOTE_ASSET=USDT
DEFAULT_TIMEFRAMES=15m,1h,4h,1d
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT

ENABLE_SENTIMENT=false
ENABLE_LLM_ANALYSIS=false
ENABLE_BACKTESTING=true
ENABLE_SCHEDULER=true
ENABLE_UNIVERSE_SCAN=true

SCAN_INTERVAL_MINUTES=60
UNIVERSE_SIZE=1000
UNIVERSE_SCAN_BATCH_SIZE=50
UNIVERSE_REFRESH_HOURS=24
CANDLE_LIMIT=500

SIGNAL_MIN_SCORE=65
SIGNAL_COOLDOWN_MINUTES=120
DISPLAY_TIMEZONE=Europe/Berlin
