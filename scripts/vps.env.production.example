# VPS-Produktion — nach /opt/alpha-trade-oracle-bot/.env kopieren und Secrets eintragen.
APP_ENV=production
LOG_LEVEL=INFO
ADMIN_API_TOKEN=change-me-to-a-long-random-token

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=alpha_trade_oracle
POSTGRES_USER=alpha_trade_oracle
POSTGRES_PASSWORD=change-me-strong-db-password

REDIS_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_CHAT_IDS=

MARKET_DATA_PROVIDER=kucoin
KUCOIN_BASE_URL=https://api.kucoin.com
DEFAULT_QUOTE_ASSET=USDT
DEFAULT_TIMEFRAMES=15m,1h,4h,1d
DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT

ENABLE_SENTIMENT=false
ENABLE_LLM_ANALYSIS=false
ENABLE_BACKTESTING=true
ENABLE_SCHEDULER=true
ENABLE_UNIVERSE_SCAN=true

SCAN_INTERVAL_MINUTES=15
UNIVERSE_SIZE=1500
UNIVERSE_SCAN_BATCH_SIZE=400
UNIVERSE_REFRESH_HOURS=24
UNIVERSE_EXCHANGES=kucoin,binance,coinbase
# false = nur Direct-Mapping (schnell, kein CG-Rate-Limit).
UNIVERSE_TICKER_FALLBACK=false
UNIVERSE_TICKER_FALLBACK_MAX=150
UNIVERSE_TARGET_COUNT=400
UNIVERSE_REQUIRE_LEVERAGE=true
UNIVERSE_LEVERAGE_VENUES=binance,kucoin,aster,hyperliquid
UNIVERSE_MAX_RANK=0
UNIVERSE_VERIFY_CANDLES=true
UNIVERSE_MIN_QUOTE_VOLUME_USD=0
CANDLE_RETENTION_DAYS=365
COINBASE_BASE_URL=https://api.coinbase.com/api/v3/brokerage
COINBASE_QUOTE_ASSETS=USD,USDC,USDT
CANDLE_LIMIT=500

SIGNAL_MIN_SCORE=75
SIGNAL_REQUIRE_STRONG=false
SIGNAL_SHORT_MAX_SCORE=25
SIGNAL_COOLDOWN_MINUTES=120
SIGNAL_RSI_LONG_MAX=75
SIGNAL_RSI_SHORT_MIN=33
SIGNAL_SHORT_MIN_SCORE=18
SIGNAL_BLOCK_RANGE_MARKET=true
SIGNAL_MIN_ADX=30
REJECT_WIDE_STOPS=false
TP_MULTIPLIERS=1.5,2.5,4.0
PAPER_SCALE_OUT_FRACTIONS=0.5,0.25,0.25
PAPER_SYMBOL_CIRCUIT_BREAKER_LOSSES=2
PAPER_SYMBOL_CIRCUIT_BREAKER_HOURS=24
SIGNAL_ENTRY_BLACKOUT_UTC=
PAPER_ENTRY_BLACKOUT_UTC=
PAPER_EXPIRY_MULTIPLIER_AFTER_TP1=48
REGIME_FILTER_ENABLED=true
REGIME_BTC_SYMBOL=BTCUSDT
REGIME_TIMEFRAME=4h
BTC_RISE_SHORT_BLOCK_ENABLED=true
BTC_RISE_1H_PCT=0.15
BTC_RISE_3H_PCT=0.35
BTC_RISE_4H_PCT=0.30
BTC_RISE_6H_PCT=0.50
BTC_RISE_USE_1H=true
BTC_RISE_USE_3H=true
BTC_RISE_USE_4H=true
BTC_RISE_USE_6H=true
BTC_RISE_CANCEL_PENDING_SHORTS=true
MARKET_REGIME_ENABLED=true
MARKET_REGIME_HARD_VETO=true
MARKET_REGIME_BTC_TIMEFRAMES=1h,4h,1d,1w
MARKET_REGIME_LIQUIDITY_VENUES=binance,bybit,hyperliquid
INSTITUTIONAL_KB_ENABLED=true
INSTITUTIONAL_ENFORCE_GATES=false

ENABLE_PAPER_TRADING=true
PAPER_INITIAL_BALANCE=5000
PAPER_MARGIN_PER_TRADE=300
PAPER_LEVERAGE=10
PAPER_RISK_PER_TRADE_USD=0
PAPER_MAX_NOTIONAL_USD=3000
PAPER_MAX_PORTFOLIO_RISK_PCT=30
PAPER_MAX_OPEN_POSITIONS=20
PAPER_MAX_OPEN_PER_DIRECTION=12
PAPER_FEE_PERCENT=0.05
PAPER_MOVE_STOP_TO_BREAKEVEN=true
PAPER_UPDATE_INTERVAL_MINUTES=5
PAPER_HOURLY_DIGEST_ENABLED=false
PAPER_DIGEST_INTERVAL_MINUTES=60
PAPER_RETEST_ENTRY_ENABLED=true
PAPER_RETEST_ZONE_NEAR=0.55
PAPER_RETEST_ZONE_FAR=1.0
PAPER_RETEST_PENDING_MULTIPLIER=6
PAPER_RETEST_MIN_BARS_IN_ZONE=1
SIGNAL_TRENDLINE_GATE_ENABLED=true
SIGNAL_TRENDLINE_LOOKBACK=40
SIGNAL_TRENDLINE_BUFFER_ATR=0.1
SIGNAL_TRENDLINE_MIN_POINTS=2
SIGNAL_TRENDLINE_MIN_R2=0.85
SIGNAL_TRENDLINE_MIN_CLEARANCE_ATR=0.0
PAPER_EARLY_SCRATCH_HOURS=12
PAPER_EARLY_SCRATCH_MFE_R=0.5
# Muss zum Paper-Entry passen, sonst misst der Backtest eine andere Strategie.
BACKTEST_RETEST_ENTRY_ENABLED=true

DISPLAY_TIMEZONE=Europe/Berlin
